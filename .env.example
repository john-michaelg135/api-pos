# ============================================================
# api-pos — environment variables
# Local development uses the split POSTGRES_* vars (docker compose).
# Production (Render) uses the PRODUCTION block further down.
# Never commit real secrets — copy real values into Render's env screen.
# ============================================================

# ── Local development: PostgreSQL (docker compose) ──
POSTGRES_DB_HOST=postgres
POSTGRES_DB_PORT=5433 # port for PostgreSQL -> include during when creating a server
POSTGRES_USERNAME=postgres # username for PostgreSQL -> include during when creating a server
POSTGRES_PASSWORD=password # password for PostgreSQL -> include during when creating a server

# pgAdmin credentials
# use email to login to pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@pgadmin.org 

# use password to login to pgAdmin
PGADMIN_DEFAULT_PASSWORD=admin

POSTGRES_DATA_PATH=./data/postgres
PGADMIN_DATA_PATH=./data/pgadmin

# Xendit Integration Keys
XENDIT_SECRET_KEY=your_xendit_secret_key_here
XENDIT_PUBLIC_KEY=your_xendit_public_key_here
XENDIT_CALLBACK_TOKEN=your_callback_token_here
XENDIT_REDIRECT_URL=http://localhost:3003/sales-processing

# Audit Log Service
AUDIT_SERVICE_URL=http://api-audit-logs:5000
AUDIT_SERVICE_ENABLED=false


# ============================================================
# PRODUCTION (Render) — set these in Render → Service → Environment.
# Do NOT set the local POSTGRES_* vars in production; use DATABASE_URL instead.
# ============================================================

# Managed Postgres (Neon). Copy the pooled connection string from the Neon
# dashboard. Both forms are accepted; SSL is enforced automatically for remote
# hosts. Neon requires SSL, so keep ?sslmode=require.
#   URI form:      postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/pos_db?sslmode=require
#   key=value form: Host=...;Port=5432;Database=pos_db;Username=...;Password=...;SSL Mode=Require
DATABASE_URL=

# Apply EF Core migrations on startup. Set to true for the FIRST deploy and
# whenever new migrations ship; the app skips seeding until the schema exists.
RUN_DB_MIGRATIONS=true

# ── Auth (br-auth integration) ──
# Enable server-side token validation + RBAC enforcement in production.
# When not "true" (local dev) all requests pass through unauthenticated.
AUTH_MIDDLEWARE_ENABLED=true

# Public HTTPS root of the Centralized Auth Service. Bearer tokens are validated
# locally against its OIDC signing keys ({JWT_AUTHORITY}/.well-known/openid-configuration),
# so no per-request call to the auth service is made. Get the production URL from
# the Auth Service owner. Must be reachable from Render. Example: https://auth.example.com
# JWT_AUTHORITY takes precedence; AUTH_SERVICE_URL is kept as a fallback.
JWT_AUTHORITY=
AUTH_SERVICE_URL=

# Optional (kept for future audience-scoped tokens; validation stays disabled).
JWT_AUDIENCE=pos-client

# Public origin of the deployed web-pos frontend, used for the CORS allowlist.
# Comma-separate if you have more than one. No trailing slash.
# Example: https://web-pos.vercel.app
WEB_POS_URL=

# SCMS integration base URL (if used). Example: https://api-scm.example.com
SCMS_API_BASE_URL=

# Xendit production keys (from the Xendit dashboard).
# XENDIT_SECRET_KEY=
# XENDIT_PUBLIC_KEY=
# XENDIT_CALLBACK_TOKEN=
# XENDIT_REDIRECT_URL=https://web-pos.vercel.app/sales-processing
