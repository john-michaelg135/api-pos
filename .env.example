# ============================================================
# api-pos — environment variables
# Local development uses the split POSTGRES_* vars (docker compose).
# Production (Render) uses the PRODUCTION block further down.
# Never commit real secrets — copy real values into Render's env screen.
# ============================================================

# ── Local development: PostgreSQL (docker compose) ──
POSTGRES_DB_HOST=postgres
POSTGRES_DB_PORT=5433 # port for PostgreSQL -> include during when creating a server
POSTGRES_USERNAME=postgres # username for PostgreSQL -> include during when creating a server
POSTGRES_PASSWORD=password # password for PostgreSQL -> include during when creating a server

# pgAdmin credentials
# use email to login to pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@pgadmin.org 

# use password to login to pgAdmin
PGADMIN_DEFAULT_PASSWORD=admin

POSTGRES_DATA_PATH=./data/postgres
PGADMIN_DATA_PATH=./data/pgadmin

# Xendit Integration Keys
XENDIT_SECRET_KEY=your_xendit_secret_key_here
XENDIT_PUBLIC_KEY=your_xendit_public_key_here
XENDIT_CALLBACK_TOKEN=your_callback_token_here
XENDIT_REDIRECT_URL=http://localhost:3003/sales-processing

# Shared audit logs, through the API gateway as its "pos" Caller.
# AUDIT_SERVICE_ENABLED=false sends nothing (set it to false to stop delivery at any time).
# POS_GATEWAY_URL is the gateway origin (no trailing slash); events go to {POS_GATEWAY_URL}/audit/events.
# POS_GATEWAY_CALLER_KEY is the server-only Caller key; never expose it to web-pos or the browser.
AUDIT_SERVICE_ENABLED=false
POS_GATEWAY_URL=
POS_GATEWAY_CALLER_KEY=

# Delivery and refund proof photos in the shared file-storage service, through the same gateway
# "pos" Caller ({POS_GATEWAY_URL}/files...). The gateway's CALLERS secret must map "pos" to
# systemCode "POS". The browser PUTs photo bytes straight to the signed storage address, so the
# private bucket's CORS must allow the web-pos origins, PUT and the Content-Type header.
# POS_UPLOAD_SIGNING_SECRET signs the upload references POS hands the browser. Server-only, at
# least 32 random bytes: openssl rand -base64 48. Leave empty to keep new uploads off (503);
# photos saved before the move to file storage stay readable either way.
POS_UPLOAD_SIGNING_SECRET=

# Staff bell (refund/void requests and decisions, SCMS deliveries, low stock). Alerts are always
# saved and shown in the POS bell. STAFF_ALERTS_ENABLED=true also sends Portal copies, keeps read
# state in sync and posts a content-free refresh notice to the POS live channel, through the same
# gateway "pos" Caller (POS_GATEWAY_URL / POS_GATEWAY_CALLER_KEY) and the Portal recipient directory
# (PORTAL_URL / PORTAL_SYSTEM_NAME / PORTAL_SYSTEM_SECRET). Set it to false to pause sends; pending
# copies stay saved and go out once it is true again. See STAFF-NOTIFICATIONS.md.
STAFF_ALERTS_ENABLED=false
# The gateway's registered sender name for POS, in its exact case (default "pos").
POS_NOTIFICATIONS_SENDING_APP=pos
# Shared live channel every POS bell listens on (default "pos-staff").
POS_NOTIFICATIONS_STAFF_CHANNEL=pos-staff
# Public web-pos origin for links in Portal copies. Defaults to the first WEB_POS_URL entry.
POS_WEB_ORIGIN=

# ── Local Enterprise Portal integration ──
PORTAL_URL=http://localhost:3000
PORTAL_SYSTEM_NAME=POS
PORTAL_SYSTEM_SECRET=
# Read-only credential to the local/mirror Enterprise Portal database.
PORTAL_DATABASE_URL=

# ============================================================
# PRODUCTION (Render) — set these in Render → Service → Environment.
# Do NOT set the local POSTGRES_* vars in production; use DATABASE_URL instead.
# ============================================================

# Managed Postgres (Neon). Copy the pooled connection string from the Neon
# dashboard. Both forms are accepted; SSL is enforced automatically for remote
# hosts. Neon requires SSL, so keep ?sslmode=require.
#   URI form:      postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/pos_db?sslmode=require
#   key=value form: Host=...;Port=5432;Database=pos_db;Username=...;Password=...;SSL Mode=Require
DATABASE_URL=

# Apply EF Core migrations on startup. Set to true for the FIRST deploy and
# whenever new migrations ship; the app skips seeding until the schema exists.
RUN_DB_MIGRATIONS=true

# ── Auth (br-auth integration) ──
# Enable legacy bearer-token validation + RBAC for APIs that still use it.
# Location APIs always validate the Enterprise Portal pos_session independently.
AUTH_MIDDLEWARE_ENABLED=true

# Public HTTPS root of the Centralized Auth Service. Bearer tokens are validated
# locally against its OIDC signing keys ({JWT_AUTHORITY}/.well-known/openid-configuration),
# so no per-request call to the auth service is made. Get the production URL from
# the Auth Service owner. Must be reachable from Render. Example: https://auth.example.com
# JWT_AUTHORITY takes precedence; AUTH_SERVICE_URL is kept as a fallback.
JWT_AUTHORITY=
AUTH_SERVICE_URL=

# Optional (kept for future audience-scoped tokens; validation stays disabled).
JWT_AUDIENCE=pos-client

# Public origin of the deployed web-pos frontend, used for the CORS allowlist.
# Comma-separate if you have more than one. No trailing slash.
# Example: https://web-pos.vercel.app
WEB_POS_URL=

# ── Enterprise Portal location API ──
# POS's registered backend secret and a read-only Portal database credential.
PORTAL_URL=https://br-auth-three.vercel.app
PORTAL_SYSTEM_NAME=POS
PORTAL_SYSTEM_SECRET=
PORTAL_DATABASE_URL=

# SCMS integration base URL (if used). Example: https://api-scm.example.com
SCMS_API_BASE_URL=
# Shared secret SCMS sends as "Authorization: Bearer <key>" when it calls POS
# (transfer manifests, branch stock, product sync). At least 32 characters.
# Generate one with: openssl rand -hex 32. Leave empty to keep SCMS access off.
SCMS_SERVICE_KEY=
# Key SCMS gives us for calling them; sent as "Authorization: Bearer <key>" on every
# POS -> SCMS call (receive confirmations, status updates). Leave empty until SCMS sends it.
SCMS_API_KEY=

# Xendit production keys (from the Xendit dashboard).
# XENDIT_SECRET_KEY=
# XENDIT_PUBLIC_KEY=
# XENDIT_CALLBACK_TOKEN=
# XENDIT_REDIRECT_URL=https://web-pos.vercel.app/sales-processing
