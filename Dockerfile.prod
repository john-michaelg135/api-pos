# ── Build stage ──
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Restore first (better layer caching)
COPY *.csproj ./
RUN dotnet restore

# Build + publish in Release
COPY . ./
RUN dotnet publish -c Release -o /app/publish --no-restore

# ── Runtime stage ──
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish ./

# Cloud hosts inject PORT; Kestrel reads ASPNETCORE_HTTP_PORTS.
# Default to 5000 for local `docker run`.
ENV ASPNETCORE_HTTP_PORTS=5000
ENV ASPNETCORE_ENVIRONMENT=Production
EXPOSE 5000

# Bind to 0.0.0.0 on whatever PORT the platform provides.
# ${PORT:-5000} lets Render/Koyeb override; local docker run uses 5000.
ENTRYPOINT ["sh", "-c", "ASPNETCORE_URLS=http://0.0.0.0:${PORT:-5000} dotnet api-pos.dll"]
